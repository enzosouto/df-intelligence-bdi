# ---------------------------------------------------------------------------
# DF Intelligence — exemplo de configuração
# Copie para `.env` e ajuste. NUNCA comite o `.env`.
# ---------------------------------------------------------------------------

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_USER=df
POSTGRES_PASSWORD=df_local_password_change_me
POSTGRES_DB=df_intelligence
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Porta exposta no host (evita conflito com um Postgres local em 5432)
POSTGRES_HOST_PORT=55432

# Usada pela ingestão e pelo dbt quando rodando FORA do Docker.
# Dentro do Docker, POSTGRES_HOST=postgres já resolve.
DATABASE_URL=postgresql://df:df_local_password_change_me@localhost:55432/df_intelligence

# --- API --------------------------------------------------------------------
API_HOST_PORT=8000
API_CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# --- Frontend ---------------------------------------------------------------
FRONTEND_HOST_PORT=5173
# Base da API vista pelo NAVEGADOR, resolvida no build do frontend.
# Deixe VAZIO no docker compose: o nginx do container serve /api via proxy,
# então frontend e API compartilham a mesma origem (sem CORS).
VITE_API_BASE_URL=

# Usado apenas por `npm run dev` fora do Docker, para o proxy do Vite.
VITE_API_PROXY_TARGET=http://localhost:8000

# --- Ingestão ---------------------------------------------------------------
# Janela do histórico climático (Open-Meteo/ERA5 tem latência de ~5 dias)
WEATHER_START_DATE=2019-01-01

# Primeiro ano de balanço criminal a ingerir (a SSP publica desde 2014)
SECURITY_START_YEAR=2014

# User-Agent enviado aos portais do GDF. O Liferay da SSP rejeita clientes
# sem UA de navegador.
HTTP_USER_AGENT="DFIntelligence/1.0 (+https://github.com/seu-usuario/df-intelligence)"

# Segundos entre requisições aos portais do GDF (educação com servidor público)
HTTP_THROTTLE_SECONDS=0.4
